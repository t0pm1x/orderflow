@startuml c4-level-3-inventory
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container_Boundary(inventory, "Inventory Service") {
    Component(inventory_handler, "Inventory HTTP", "chi handler", "POST /v1/inventory/reserve")
    Component(stock_model, "Stock Model", "Go struct + version", "Optimistic locking")
    Component(redis_reserve, "Redis Reservation", "Go", "TTL-based reservation store")
    Component(outbox_poller, "Outbox Poller", "Go", "Publishes inventory events")
    Component(consumer, "Inventory Consumer", "Go", "Consumes inventory events")
}

Rel(inventory_handler, stock_model, "Updates with version check")
Rel(inventory_handler, redis_reserve, "Creates reservation")
Rel(consumer, stock_model, "Updates stock")

@enduml
