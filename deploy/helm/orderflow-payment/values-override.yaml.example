# Example values-override file for the Payment Service chart.
# Copy this file to `values-override.yaml` (or pass via `--values`)
# and fill in real connection strings. Without these, the chart's
# Secret is created with empty values and the pods will fail their
# liveness probe at startup.
#
# Two ways to provide secrets:
#
# (a) Chart-managed Secret (default — `secret.create: true`).
#     Populate `secret.data` with the real values:
#
# secret:
#   create: true
#   data:
#     DATABASE_URL: "postgres://orderflow:CHANGEME@postgres:5432/payment_payment?sslmode=disable"
#     KAFKA_BROKERS: "redpanda:9092"
#     REDIS_URL: "redis://redis:6379/0"
#
# (b) Externally-managed Secret. Set `secret.create: false` and
#     `secret.existingSecret` to the Secret name you provisioned:
#
# secret:
#   create: false
#   existingSecret: "orderflow-payment-secrets"
# # Required keys in the Secret:
# #   - DATABASE_URL
# #   - KAFKA_BROKERS
# #   - REDIS_URL
